<Project Sdk="Microsoft.NET.Sdk">

  <!-- Nullable and ImplicitUsings are inherited from the root Directory.Build.props.
       TargetFramework must stay net10.0-windows here (WPF), overriding the root default.
       CS1591 is kept as a warning (not an error), per the design's "Code documentation
       standard": XAML code-behind generated members cannot always carry an XML doc comment.
       No BlazorWebView yet (Phase 3): WebView2 Runtime is not installed on this machine,
       so Phase 0 ships a plain WPF window that builds the generic host, wires logging,
       and exits — see MainWindow.xaml.cs and App.xaml.cs. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <WarningsNotAsErrors>CS1591</WarningsNotAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RhinoSurfaceMapper.Domain\RhinoSurfaceMapper.Domain.csproj" />
    <ProjectReference Include="..\RhinoSurfaceMapper.Application\RhinoSurfaceMapper.Application.csproj" />
    <ProjectReference Include="..\RhinoSurfaceMapper.Infrastructure\RhinoSurfaceMapper.Infrastructure.csproj" />
    <ProjectReference Include="..\RhinoSurfaceMapper.Platform.Windows\RhinoSurfaceMapper.Platform.Windows.csproj" />
    <ProjectReference Include="..\RhinoSurfaceMapper.UI.Components\RhinoSurfaceMapper.UI.Components.csproj" />
  </ItemGroup>

</Project>
