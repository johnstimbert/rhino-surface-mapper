@* Minimal functional dialog for creating or editing a named marker (bearing + distance from the
   live Rhino position), dispatching Features.Markers.CreateMark/UpdateMark via IMediator. Ported
   data contract only from qt_map_operations' mark/alter_mark dialogs. *@
@namespace RhinoSurfaceMapper.UI.Components.Dialogs

@if (IsOpen)
{
    <div class="dialog-backdrop">
        <div class="dialog-box">
            <h3>@(MarkId is null ? "New mark" : "Edit mark")</h3>

            <div class="dialog-field">
                <label for="mark-name">Name</label>
                <input id="mark-name" @bind="Name" @bind:event="oninput" />
            </div>

            <div class="dialog-field">
                <label for="mark-azimuth">Bearing (degrees)</label>
                <input id="mark-azimuth" type="number" step="0.1" @bind="AzimuthDegrees" />
            </div>

            <div class="dialog-field">
                <label for="mark-distance">Distance (metres)</label>
                <input id="mark-distance" type="number" min="0" step="0.1" @bind="DistanceMetres" />
            </div>

            @if (ErrorMessage is not null)
            {
                <p class="dialog-error">@ErrorMessage</p>
            }

            <div class="dialog-actions">
                <button type="button" @onclick="CancelAsync" disabled="@_busy">Cancel</button>
                <button type="button" @onclick="SubmitAsync" disabled="@_busy">Save</button>
            </div>
        </div>
    </div>
}
