<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!-- TargetFramework, Nullable, ImplicitUsings and documentation settings are inherited
       from the root Directory.Build.props. CS1591 is kept as a warning (not an error) here,
       per the design's "Code documentation standard": Razor-backed generated members
       cannot always carry an XML doc comment. No MudBlazor: plain Razor + scoped CSS (D-decision). -->
  <PropertyGroup>
    <WarningsNotAsErrors>CS1591</WarningsNotAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RhinoSurfaceMapper.Application\RhinoSurfaceMapper.Application.csproj" />
    <ProjectReference Include="..\RhinoSurfaceMapper.Domain\RhinoSurfaceMapper.Domain.csproj" />
  </ItemGroup>

</Project>
